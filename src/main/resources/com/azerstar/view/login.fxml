<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="600.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.azerstar.controller.LoginController">
   <children>
      <VBox alignment="CENTER" minWidth="430.0" prefWidth="430.0" spacing="16.0" styleClass="hero">
         <children>
            <Label styleClass="brand-mark" text="A" />
            <Label style="-fx-font-size: 38px;" styleClass="hero-title" text="AzərStar" />
            <Label styleClass="hero-text" text="Fındıq emalı və anbar uçotu" />
         </children>
      </VBox>
      <StackPane styleClass="screen" HBox.hgrow="ALWAYS">
         <children>
            <VBox maxHeight="-Infinity" maxWidth="360.0" spacing="8.0" styleClass="login-card">
               <padding>
                  <Insets bottom="34.0" left="34.0" right="34.0" top="34.0" />
               </padding>
               <children>
                  <Label styleClass="login-title" text="Daxil ol" />
                  <Label styleClass="page-subtitle" text="Hesabınıza daxil olun" />
                  <Label styleClass="form-label" text="İstifadəçi adı">
                     <VBox.margin>
                        <Insets top="16.0" />
                     </VBox.margin>
                  </Label>
                  <TextField fx:id="usernameTextField" promptText="İstifadəçi adı" />
                  <Label styleClass="form-label" text="Şifrə">
                     <VBox.margin>
                        <Insets top="6.0" />
                     </VBox.margin>
                  </Label>
                  <PasswordField fx:id="passwordTextField" promptText="Şifrə" />
                  <Label fx:id="loginMessageLabel" styleClass="error-text" wrapText="true" />
                  <Button fx:id="loginButton" defaultButton="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#loginButtonOnAction" styleClass="primary-button" text="Daxil ol" />
                  <Button fx:id="backButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#backButtonOnAction" styleClass="ghost-button" text="←  Geri" />
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</HBox>
