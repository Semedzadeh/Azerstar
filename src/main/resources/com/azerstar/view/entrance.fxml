<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="600.0" prefWidth="1000.0" styleClass="hero" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.azerstar.controller.EntranceController">
   <children>
      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" spacing="16.0">
         <children>
            <Label styleClass="brand-mark" text="A" />
            <Label styleClass="hero-title" text="AzərStar" />
            <Label styleClass="hero-text" text="Azərstar MMC  ·  fındıq emalı və anbar uçotu" />
            <Button fx:id="entranceButton" mnemonicParsing="false" onAction="#entranceButtonOnAction" styleClass="primary-button, hero-button" text="Daxil ol">
               <VBox.margin>
                  <Insets top="26.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </children>
</StackPane>
