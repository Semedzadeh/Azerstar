<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="1000.0" styleClass="screen" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.azerstar.controller.MainMenuController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="top-bar">
         <padding>
            <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
         </padding>
         <children>
            <Label styleClass="brand-mark" text="A" />
            <Label styleClass="brand-name" text="AzərStar" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox fx:id="userBox" alignment="CENTER_RIGHT" />
         </children>
      </HBox>
   </top>
   <center>
      <VBox spacing="6.0">
         <padding>
            <Insets bottom="20.0" left="44.0" right="44.0" top="34.0" />
         </padding>
         <children>
            <Label fx:id="welcomeLabel" styleClass="page-title" />
            <Label styleClass="page-subtitle" text="Əməliyyatı seçin" />
            <FlowPane fx:id="grid" hgap="24.0" prefWrapLength="920.0" vgap="24.0">
               <VBox.margin>
                  <Insets top="26.0" />
               </VBox.margin>
            </FlowPane>
         </children>
      </VBox>
   </center>
</BorderPane>
